# Queue contents are local runtime state, never committed.
data/
*.jsonl

# Node. The server itself still has zero runtime dependencies; the /v2
# Hono+OpenAPI proof-of-concept (see HONO-POC.md) added real ones, so the
# lockfile is now committed for reproducible installs.
node_modules/
npm-debug.log*

# ocli's local profile/spec cache, created by `npx ocli profiles add` when
# generating a CLI against /v2/openapi.json — machine-local test state.
.ocli/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local overrides
.env
.env.*
docker-compose.override.yml

# Local agent-harness config (hooks, settings, violation logs) — machine-local, never published.
.claude/

# Scratch mutant copies of server.js, written next to it (not in the OS temp
# dir) so its relative requires (./icons.js, ./push.js, ./share.js) resolve.
# tools/seat-unwatched-selftest.js cleans these up itself; ignored here too in
# case a killed test run leaves one behind.
*.mutant.js
