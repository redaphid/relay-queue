{
  "name": "relay-queue",
  "version": "1.1.0",
  "private": true,
  "description": "Minimal durable local-only HTTP task queue with a mobile web UI, for passing messages between a human and their agents. Zero runtime dependencies.",
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tools/ui-selftest.js && node tools/mobile-selftest.js",
    "test:fast": "node tools/ui-selftest.js",
    "test:mobile": "node tools/mobile-selftest.js",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  }
}
